<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asv_station_gz_bridge</name>
  <version>0.1.0</version>
  <description>
    Fortress transport bridge: applies ROS-commanded wind/wave wrenches to
    hulls (ApplyLinkWrench) and moves visual-only markers (set_pose).
  </description>
  <maintainer email="gt0908@srmist.edu.in">gt0908</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ignition-msgs8</depend>
  <depend>ignition-transport11</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
