<?xml version="1.0"?>
<sdf version="1.8">
  <world name="asv_test">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.85 0.9 1</background>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- A visual water plane and a low contact plane keep this standalone
         inspection world usable without a separate buoyancy system. -->
    <model name="water_surface">
      <static>true</static>
      <link name="water">
        <visual name="water_visual">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.1 0.35 0.55 1</ambient><diffuse>0.1 0.35 0.55 1</diffuse></material>
        </visual>
        <collision name="water_collision">
          <pose>0 0 -0.25 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
      </link>
    </model>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></ignition-gui>
        <!-- Ogre 1 is more tolerant of older / hybrid GPU drivers than the
             Fortress default Ogre 2 renderer. -->
        <engine>ogre</engine><scene>scene</scene>
        <camera_pose>-1.6 -1.6 1.0 0 0.55 0.785398</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World Control">
        <ignition-gui><property type="bool" key="showTitleBar">false</property><property type="string" key="state">floating</property></ignition-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused>
      </plugin>
      <plugin filename="EntityTree" name="Entity Tree"/>
    </gui>
  </world>
</sdf>
