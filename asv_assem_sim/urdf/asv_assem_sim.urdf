<?xml version="1.0"?>
<!--
  ASV Dynamic Station Keeping simulation model

  The original Fusion 360 / ACDC export contained 59 links, no joints, and
  repeated link names.  This file is the cleaned assembly model:

    * base_link is the inertial root and base_footprint is a TF-only frame.
    * the two pontoons, deck, equipment and supports are connected with fixed
      joints at the recovered assembly locations.
    * every thruster has a real revolute steering joint.  The empty mount and
      steering links keep the yaw axis vertical while the T200 mesh is pitched
      90 degrees to make its native Z axis horizontal.
    * visual meshes retain the CAD detail; primitive collisions keep Gazebo
      contacts fast and stable.

  Coordinate convention: X forward, Y left/port, Z up.  Units are metres,
  kilograms and radians.
-->
<robot name="asv_assem_sim">

  <!-- KDL-friendly TF root.  The physical inertial root is base_link. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ============================ HULLS ============================ -->
  <!-- The CAD hull is centred and rotated so its native long Y axis is X. -->
  <link name="hull_left">
    <inertial>
      <origin xyz="0.0017543 -0.0000047 -0.0000010" rpy="0 0 0"/>
      <mass value="8.7513272838"/>
      <!-- Original CAD inertia transformed by Rz(-pi/2). -->
      <inertia ixx="0.0159438897" ixy="0" ixz="0" iyy="0.7485544942" iyz="0" izz="0.7485544942"/>
    </inertial>
    <visual name="hull_left_visual">
      <origin xyz="-0.971730 0.357754 -1.641617" rpy="0 0 -1.57079632679"/>
      <geometry><mesh filename="package://asv_assem_sim/meshes/hull.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision name="hull_left_collision">
      <geometry><box size="0.724805 0.112973 0.112998"/></geometry>
    </collision>
  </link>

  <link name="hull_right">
    <inertial>
      <origin xyz="0.0017543 -0.0000047 -0.0000010" rpy="0 0 0"/>
      <mass value="8.7513272838"/>
      <inertia ixx="0.0159438897" ixy="0" ixz="0" iyy="0.7485544942" iyz="0" izz="0.7485544942"/>
    </inertial>
    <visual name="hull_right_visual">
      <origin xyz="-0.971730 0.357754 -1.641617" rpy="0 0 -1.57079632679"/>
      <geometry><mesh filename="package://asv_assem_sim/meshes/hull.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision name="hull_right_collision">
      <geometry><box size="0.724805 0.112973 0.112998"/></geometry>
    </collision>
  </link>

  <joint name="base_to_hull_left" type="fixed">
    <parent link="base_link"/><child link="hull_left"/>
    <origin xyz="0 0.175 0.055" rpy="0 0 0"/>
  </joint>
  <joint name="base_to_hull_right" type="fixed">
    <parent link="base_link"/><child link="hull_right"/>
    <origin xyz="0 -0.175 0.055" rpy="0 0 0"/>
  </joint>

  <!-- ============================= DECK ============================ -->
  <!-- The raw deck is rotated about X: 350 x 490 x 12 mm horizontal deck. -->
  <link name="base_deck">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="16.1553"/>
      <inertia ixx="0.3234344911" ixy="0" ixz="0" iyy="0.1651125511" iyz="0" izz="0.4881593150"/>
    </inertial>
    <visual name="base_deck_visual">
      <origin xyz="-0.142254 -0.216347 -0.006000" rpy="1.57079632679 0 0"/>
      <geometry><mesh filename="package://asv_assem_sim/meshes/base_deck.stl" scale="0.001 0.001 0.001"/></geometry>
    </visual>
    <collision name="base_deck_collision">
      <geometry><box size="0.350 0.490 0.012"/></geometry>
    </collision>
  </link>
  <joint name="base_to_base_deck" type="fixed">
    <parent link="base_link"/><child link="base_deck"/>
    <origin xyz="0 0 0.145" rpy="0 0 0"/>
  </joint>

  <!-- ========================== SUPPORTS =========================== -->
  <!-- The six exported frame instances are vertical support posts. -->
  <link name="frame1_left">
    <inertial><origin xyz="0 0 0"/><mass value="0.41469714"/><inertia ixx="0.00333785" ixy="0" ixz="0" iyy="0.00333785" iyz="0" izz="0.0000336422"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame1.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.310"/></geometry></collision>
  </link>
  <link name="frame1_right">
    <inertial><origin xyz="0 0 0"/><mass value="0.41469714"/><inertia ixx="0.00333785" ixy="0" ixz="0" iyy="0.00333785" iyz="0" izz="0.0000336422"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame1.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.310"/></geometry></collision>
  </link>
  <link name="frame2_left">
    <inertial><origin xyz="0 0 0"/><mass value="0.66886635"/><inertia ixx="0.01396185" ixy="0" ixz="0" iyy="0.01396185" iyz="0" izz="0.000054262"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame2.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.500"/></geometry></collision>
  </link>
  <link name="frame2_right">
    <inertial><origin xyz="0 0 0"/><mass value="0.66886635"/><inertia ixx="0.01396185" ixy="0" ixz="0" iyy="0.01396185" iyz="0" izz="0.000054262"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame2.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.500"/></geometry></collision>
  </link>
  <link name="frame3_left">
    <inertial><origin xyz="0 0 0"/><mass value="0.66886635"/><inertia ixx="0.01396185" ixy="0" ixz="0" iyy="0.01396185" iyz="0" izz="0.000054262"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame3.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.500"/></geometry></collision>
  </link>
  <link name="frame3_right">
    <inertial><origin xyz="0 0 0"/><mass value="0.66886635"/><inertia ixx="0.01396185" ixy="0" ixz="0" iyy="0.01396185" iyz="0" izz="0.000054262"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/frame3.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><cylinder radius="0.010" length="0.500"/></geometry></collision>
  </link>

  <joint name="deck_to_frame1_left" type="fixed"><parent link="base_deck"/><child link="frame1_left"/><origin xyz="-0.12 0.14 0.22"/></joint>
  <joint name="deck_to_frame1_right" type="fixed"><parent link="base_deck"/><child link="frame1_right"/><origin xyz="0.12 0.14 0.22"/></joint>
  <joint name="deck_to_frame2_left" type="fixed"><parent link="base_deck"/><child link="frame2_left"/><origin xyz="-0.12 -0.14 0.28"/></joint>
  <joint name="deck_to_frame2_right" type="fixed"><parent link="base_deck"/><child link="frame2_right"/><origin xyz="0.12 -0.14 0.28"/></joint>
  <joint name="deck_to_frame3_left" type="fixed"><parent link="base_deck"/><child link="frame3_left"/><origin xyz="-0.12 0 0.28"/></joint>
  <joint name="deck_to_frame3_right" type="fixed"><parent link="base_deck"/><child link="frame3_right"/><origin xyz="0.12 0 0.28"/></joint>

  <!-- =========================== EQUIPMENT ========================= -->
  <link name="battery">
    <inertial><origin xyz="0.011821 0 0.000846"/><mass value="8.29420474"/><inertia ixx="0.0317350" ixy="0" ixz="0.0000687" iyy="0.0339037" iyz="0" izz="0.00778636"/></inertial>
    <visual><origin xyz="0.012244 -0.035000 -0.000150"/><geometry><mesh filename="package://asv_assem_sim/meshes/battery.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.109 0.070 0.202"/></geometry></collision>
  </link>
  <joint name="deck_to_battery" type="fixed"><parent link="base_deck"/><child link="battery"/><origin xyz="-0.06 0 0.265"/></joint>

  <link name="electronics">
    <inertial><origin xyz="0 -0.005565 -0.000224"/><mass value="4.50915118"/><inertia ixx="0.0697094" ixy="0" ixz="0" iyy="0.1035140" iyz="-0.00452282" izz="0.0519051"/></inertial>
    <visual><origin xyz="0 -0.051000 -0.023578"/><geometry><mesh filename="package://asv_assem_sim/meshes/electronics.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.300 0.102 0.447"/></geometry></collision>
  </link>
  <joint name="deck_to_electronics" type="fixed"><parent link="base_deck"/><child link="electronics"/><origin xyz="0.08 0 0.370"/></joint>

  <link name="jetson_nano">
    <inertial><origin xyz="-0.001623 0.002547 -0.004382"/><mass value="0.55767391"/><inertia ixx="0.00033845" ixy="0.000000893" ixz="0.00000257" iyy="0.00033690" iyz="-0.00004065" izz="0.00056875"/></inertial>
    <visual><origin xyz="-0.004000 -0.007385 -0.025097"/><geometry><mesh filename="package://asv_assem_sim/meshes/Jetson-Nano.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.100 0.080 0.040"/></geometry></collision>
  </link>
  <joint name="electronics_to_jetson" type="fixed"><parent link="electronics"/><child link="jetson_nano"/><origin xyz="0 0 0.255"/></joint>

  <link name="imu_link">
    <inertial><origin xyz="-0.00000256 0.00000402 0"/><mass value="0.00700317"/><inertia ixx="0.0000002895" ixy="0.000000000021" ixz="0" iyy="0.0000003634" iyz="0" izz="0.0000006497"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/imu_Adafruit-BNO085-STEMMA-QT.step_Printed-Circuit-Board.step.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.0254 0.0229 0.00165"/></geometry></collision>
  </link>
  <joint name="electronics_to_imu" type="fixed"><parent link="electronics"/><child link="imu_link"/><origin xyz="0 0 0.255"/></joint>

  <link name="gps">
    <inertial><origin xyz="0.000722 -0.000920 -0.001504"/><mass value="0.0120864"/><inertia ixx="0.0000007935" ixy="-0.0000001189" ixz="-0.0000000123" iyy="0.0000003115" iyz="-0.0000000289" izz="0.0000010352"/></inertial>
    <visual><origin xyz="0.477241 -0.271714 -0.058863"/><geometry><mesh filename="package://asv_assem_sim/meshes/gps.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.018 0.038 0.010"/></geometry></collision>
  </link>
  <joint name="deck_to_gps" type="fixed"><parent link="base_deck"/><child link="gps"/><origin xyz="-0.12 0 0.66"/></joint>

  <link name="gps_antenna">
    <inertial><origin xyz="0 -0.023073 0.000028"/><mass value="0.00977979"/><inertia ixx="0.0000006570" ixy="0" ixz="0" iyy="0.0000001906" iyz="0.0000000297" izz="0.0000007948"/></inertial>
    <visual><origin xyz="0 -0.024375 -0.002900"/><geometry><mesh filename="package://asv_assem_sim/meshes/gps_antenna.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.015 0.064 0.006"/></geometry></collision>
  </link>
  <joint name="gps_to_antenna" type="fixed"><parent link="gps"/><child link="gps_antenna"/><origin xyz="0 0 0.010"/></joint>

  <link name="zed_camera">
    <inertial><origin xyz="0.001495 -0.005480 -0.000004"/><mass value="0.43618915"/><inertia ixx="0.00004355" ixy="-0.00000770" ixz="0.000000005" iyy="0.00057262" iyz="0.000000007" izz="0.00057177"/></inertial>
    <visual><origin xyz="0.002250 -0.015125 -0.000012"/><geometry><mesh filename="package://asv_assem_sim/meshes/zed_camera.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.125 0.030 0.027"/></geometry></collision>
  </link>
  <joint name="deck_to_zed_camera" type="fixed"><parent link="base_deck"/><child link="zed_camera"/><origin xyz="0.27 0 0.31" rpy="0 0 0"/></joint>

  <!-- =========================== CLAMPS ============================ -->
  <link name="clamp_left_front">
    <inertial><origin xyz="0 0.001988 0"/><mass value="0.10948492"/><inertia ixx="0.00019881" ixy="0" ixz="0" iyy="0.00029460" iyz="0" izz="0.00048607"/></inertial>
    <visual><origin xyz="-0.039825 -0.046506 -0.010000"/><geometry><mesh filename="package://asv_assem_sim/meshes/clamp.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.163 0.120 0.020"/></geometry></collision>
  </link>
  <link name="clamp_left_rear">
    <inertial><origin xyz="0 0.001988 0"/><mass value="0.10948492"/><inertia ixx="0.00019881" ixy="0" ixz="0" iyy="0.00029460" iyz="0" izz="0.00048607"/></inertial>
    <visual><origin xyz="-0.039825 -0.046506 -0.010000"/><geometry><mesh filename="package://asv_assem_sim/meshes/clamp.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.163 0.120 0.020"/></geometry></collision>
  </link>
  <link name="clamp_right_front">
    <inertial><origin xyz="0 0.001988 0"/><mass value="0.10948492"/><inertia ixx="0.00019881" ixy="0" ixz="0" iyy="0.00029460" iyz="0" izz="0.00048607"/></inertial>
    <visual><origin xyz="-0.039825 -0.046506 -0.010000"/><geometry><mesh filename="package://asv_assem_sim/meshes/clamp.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.163 0.120 0.020"/></geometry></collision>
  </link>
  <link name="clamp_right_rear">
    <inertial><origin xyz="0 0.001988 0"/><mass value="0.10948492"/><inertia ixx="0.00019881" ixy="0" ixz="0" iyy="0.00029460" iyz="0" izz="0.00048607"/></inertial>
    <visual><origin xyz="-0.039825 -0.046506 -0.010000"/><geometry><mesh filename="package://asv_assem_sim/meshes/clamp.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><geometry><box size="0.163 0.120 0.020"/></geometry></collision>
  </link>

  <joint name="hull_left_to_clamp_front" type="fixed"><parent link="hull_left"/><child link="clamp_left_front"/><origin xyz="0.25 0 -0.045"/></joint>
  <joint name="hull_left_to_clamp_rear" type="fixed"><parent link="hull_left"/><child link="clamp_left_rear"/><origin xyz="-0.25 0 -0.045"/></joint>
  <joint name="hull_right_to_clamp_front" type="fixed"><parent link="hull_right"/><child link="clamp_right_front"/><origin xyz="0.25 0 -0.045"/></joint>
  <joint name="hull_right_to_clamp_rear" type="fixed"><parent link="hull_right"/><child link="clamp_right_rear"/><origin xyz="-0.25 0 -0.045"/></joint>

  <!-- ========================= THRUSTERS =========================== -->
  <!-- Each body reuses the CAD T200 mesh.  Native +Z becomes horizontal. -->
  <link name="thruster_left_front">
    <inertial><origin xyz="-0.00000045 -0.000559 -0.003931"/><mass value="1.53247132"/><inertia ixx="0.00129639" ixy="0.000000010" ixz="-0.000000025" iyy="0.00126010" iyz="0.000005355" izz="0.00143761"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/thruster.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 -0.011060"/><geometry><cylinder radius="0.049" length="0.112679"/></geometry></collision>
  </link>
  <link name="thruster_left_rear">
    <inertial><origin xyz="-0.00000045 -0.000559 -0.003931"/><mass value="1.53247132"/><inertia ixx="0.00129639" ixy="0.000000010" ixz="-0.000000025" iyy="0.00126010" iyz="0.000005355" izz="0.00143761"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/thruster.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 -0.011060"/><geometry><cylinder radius="0.049" length="0.112679"/></geometry></collision>
  </link>
  <link name="thruster_right_front">
    <inertial><origin xyz="-0.00000045 -0.000559 -0.003931"/><mass value="1.53247132"/><inertia ixx="0.00129639" ixy="0.000000010" ixz="-0.000000025" iyy="0.00126010" iyz="0.000005355" izz="0.00143761"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/thruster.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 -0.011060"/><geometry><cylinder radius="0.049" length="0.112679"/></geometry></collision>
  </link>
  <link name="thruster_right_rear">
    <inertial><origin xyz="-0.00000045 -0.000559 -0.003931"/><mass value="1.53247132"/><inertia ixx="0.00129639" ixy="0.000000010" ixz="-0.000000025" iyy="0.00126010" iyz="0.000005355" izz="0.00143761"/></inertial>
    <visual><geometry><mesh filename="package://asv_assem_sim/meshes/thruster.stl" scale="0.001 0.001 0.001"/></geometry></visual>
    <collision><origin xyz="0 0 -0.011060"/><geometry><cylinder radius="0.049" length="0.112679"/></geometry></collision>
  </link>

  <!-- Small intermediate links make the steering axis unambiguous. -->
  <link name="thruster_left_front_mount"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_left_front_steer"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_left_rear_mount"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_left_rear_steer"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_right_front_mount"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_right_front_steer"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_right_rear_mount"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="thruster_right_rear_steer"><inertial><mass value="0.01"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial></link>

  <!-- Fixed mount poses set the initial diagonal thrust directions. -->
  <joint name="left_front_mount_joint" type="fixed"><parent link="hull_left"/><child link="thruster_left_front_mount"/><origin xyz="0.25 0 -0.050" rpy="0 0 0.7853981634"/></joint>
  <joint name="left_rear_mount_joint" type="fixed"><parent link="hull_left"/><child link="thruster_left_rear_mount"/><origin xyz="-0.25 0 -0.050" rpy="0 0 2.3561944902"/></joint>
  <joint name="right_front_mount_joint" type="fixed"><parent link="hull_right"/><child link="thruster_right_front_mount"/><origin xyz="0.25 0 -0.050" rpy="0 0 -0.7853981634"/></joint>
  <joint name="right_rear_mount_joint" type="fixed"><parent link="hull_right"/><child link="thruster_right_rear_mount"/><origin xyz="-0.25 0 -0.050" rpy="0 0 -2.3561944902"/></joint>

  <!-- These are the four user-commandable movement joints. -->
  <joint name="left_front_steering_joint" type="revolute">
    <parent link="thruster_left_front_mount"/><child link="thruster_left_front_steer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="50" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <joint name="left_rear_steering_joint" type="revolute">
    <parent link="thruster_left_rear_mount"/><child link="thruster_left_rear_steer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="50" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <joint name="right_front_steering_joint" type="revolute">
    <parent link="thruster_right_front_mount"/><child link="thruster_right_front_steer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="50" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <joint name="right_rear_steering_joint" type="revolute">
    <parent link="thruster_right_rear_mount"/><child link="thruster_right_rear_steer"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="50" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>

  <!--
    The four continuous propeller joints pitch the native thruster Z axis
    into the horizontal plane and make the complete CAD thruster spin.  The
    export has no separate propeller solid, so the thruster body is the
    visible rotating link.  This gives Gazebo a real propeller joint for the
    native maritime Thruster system to drive.
  -->
  <joint name="left_front_propeller_joint" type="continuous">
    <parent link="thruster_left_front_steer"/><child link="thruster_left_front"/>
    <origin xyz="0 0 0" rpy="0 1.57079632679 0"/><axis xyz="0 0 1"/>
    <limit effort="50" velocity="100"/><dynamics damping="0.01" friction="0.001"/>
  </joint>
  <joint name="left_rear_propeller_joint" type="continuous">
    <parent link="thruster_left_rear_steer"/><child link="thruster_left_rear"/>
    <origin xyz="0 0 0" rpy="0 1.57079632679 0"/><axis xyz="0 0 1"/>
    <limit effort="50" velocity="100"/><dynamics damping="0.01" friction="0.001"/>
  </joint>
  <joint name="right_front_propeller_joint" type="continuous">
    <parent link="thruster_right_front_steer"/><child link="thruster_right_front"/>
    <origin xyz="0 0 0" rpy="0 1.57079632679 0"/><axis xyz="0 0 1"/>
    <limit effort="50" velocity="100"/><dynamics damping="0.01" friction="0.001"/>
  </joint>
  <joint name="right_rear_propeller_joint" type="continuous">
    <parent link="thruster_right_rear_steer"/><child link="thruster_right_rear"/>
    <origin xyz="0 0 0" rpy="0 1.57079632679 0"/><axis xyz="0 0 1"/>
    <limit effort="50" velocity="100"/><dynamics damping="0.01" friction="0.001"/>
  </joint>

  <!-- ========================== GAZEBO ============================= -->
  <!-- Native Fortress systems publish joint states and accept cmd_pos. -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/asv/joint_states</topic>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_front_steering_joint</joint_name>
      <topic>/model/asv/joint/left_front_steering_joint/cmd_pos</topic>
      <p_gain>20</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_rear_steering_joint</joint_name>
      <topic>/model/asv/joint/left_rear_steering_joint/cmd_pos</topic>
      <p_gain>20</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_front_steering_joint</joint_name>
      <topic>/model/asv/joint/right_front_steering_joint/cmd_pos</topic>
      <p_gain>20</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_rear_steering_joint</joint_name>
      <topic>/model/asv/joint/right_rear_steering_joint/cmd_pos</topic>
      <p_gain>20</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
    </plugin>
    <!-- Fortress maritime thruster systems. Commands are forces in Newtons. -->
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <joint_name>left_front_propeller_joint</joint_name>
      <propeller_diameter>0.0762</propeller_diameter>
      <fluid_density>1000</fluid_density><thrust_coefficient>1</thrust_coefficient>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd><min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <joint_name>left_rear_propeller_joint</joint_name>
      <propeller_diameter>0.0762</propeller_diameter>
      <fluid_density>1000</fluid_density><thrust_coefficient>1</thrust_coefficient>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd><min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <joint_name>right_front_propeller_joint</joint_name>
      <propeller_diameter>0.0762</propeller_diameter>
      <fluid_density>1000</fluid_density><thrust_coefficient>1</thrust_coefficient>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd><min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <joint_name>right_rear_propeller_joint</joint_name>
      <propeller_diameter>0.0762</propeller_diameter>
      <fluid_density>1000</fluid_density><thrust_coefficient>1</thrust_coefficient>
      <velocity_control>true</velocity_control>
      <max_thrust_cmd>50</max_thrust_cmd><min_thrust_cmd>-50</min_thrust_cmd>
    </plugin>
  </gazebo>

  <gazebo reference="hull_left"><self_collide>false</self_collide><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="hull_right"><self_collide>false</self_collide><mu1>0.3</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on><update_rate>100</update_rate><visualize>false</visualize>
      <topic>/asv/imu</topic>
    </sensor>
  </gazebo>
  <gazebo reference="gps">
    <sensor name="gps_sensor" type="navsat">
      <always_on>true</always_on><update_rate>10</update_rate><topic>/asv/gps</topic>
    </sensor>
  </gazebo>
  <gazebo reference="zed_camera">
    <sensor name="zed_camera_sensor" type="camera">
      <always_on>true</always_on><update_rate>30</update_rate><visualize>true</visualize>
      <topic>/asv/camera/image</topic>
      <camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>100</far></clip></camera>
    </sensor>
  </gazebo>
</robot>
